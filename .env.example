# Database Configuration
DB_PASSWORD=change-this-secure-password

# API Keys (generate secure random keys for production)
ADMIN_API_KEY=change-this-to-a-secure-random-admin-key
LISTENER_API_KEY=generate-a-secure-random-key-here

# Automatic Listener Initialization (RECOMMENDED for first-time setup)
# Set these to automatically create a listener on first start
# IMPORTANT: INIT_LISTENER_API_KEY must match LISTENER_API_KEY above
INIT_LISTENER_NAME=My Meshcore Listener
INIT_LISTENER_API_KEY=generate-a-secure-random-key-here

# Listener Configuration
# After first start, update LISTENER_ID with the auto-generated ID from logs
# Or set to a specific UUID if creating listener manually via admin API
LISTENER_ID=00000000-0000-0000-0000-000000000000
LISTENER_NAME=My Meshcore Listener
DEVICE_PATH=/dev/ttyUSB0
DEVICE_BAUD_RATE=115200
POLL_INTERVAL_SECONDS=30

# Processing Configuration
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TRACE_THROTTLE_SECONDS=30
TRACE_VERIFICATION_INTERVAL_HOURS=24
GRAPH_REBUILD_INTERVAL_MINUTES=5

# Visualization Configuration
VITE_API_URL=http://localhost:8000
